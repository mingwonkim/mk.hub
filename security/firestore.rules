rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'kmin5940@naver.com'
        && request.auth.token.email_verified == true
        && request.auth.token.vault_owner == true
        && request.auth.token.vault_access == true
        && request.auth.token.vault_otp_at <= request.time.toMillis()
        && request.time.toMillis() - request.auth.token.vault_otp_at < 43200000
        && request.auth.token.vault_version == get(/databases/$(database)/documents/mk_security/access).data.version;
    }
    match /mk_app/{root} { allow read, write: if owner(); }
    match /mk_app/{root}/{collection}/{document=**} {
      allow read, write: if owner() && (root != 'data' || collection != 'briefs');
    }
    // 메인 화면(도시)의 칸: 드론(모닝 브리프)·음악·예술·IT — 누구나 읽기만
    match /mk_app/data/{collection}/{docId} {
      allow read: if collection in ['briefs', 'room_art', 'room_it', 'fav_songs', 'music_notes', 'playlists', 'playlist_songs'];
    }
    // 방명록(드론 칸): 누구나 읽고 남김 — 이름·한마디·시각만, 길이 제한. 고치기 없음, 지우기는 주인만
    match /mk_app/data/guestbook/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'msg', 'c'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.msg is string && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 500
        && request.resource.data.c is int && request.resource.data.c <= request.time.toMillis() + 60000;
      allow delete: if owner();
    }
    match /mk_app/data/briefs/{briefId} {
      allow read, delete: if owner();
      allow update: if owner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
